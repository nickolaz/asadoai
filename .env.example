# Crear en Vercel AI Gateway y guardar como secreto en Webflow Cloud.
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# Dejar vacío en local. En Webflow Cloud debe coincidir con el mount path,
# por ejemplo: /app.
NEXT_PUBLIC_BASE_PATH=

# Token público pk.* de Mapbox. Restringirlo al dominio publicado antes de usarlo
# y reiniciar Next.js después de cambiarlo.
NEXT_PUBLIC_MAPBOX_TOKEN=
